<launch>
    <!--
      Deterministik sıralı simülasyon: tüm İHA'lar ve tüm bileşenler (yörünge, orta/alt seviye
      kontrolcü, bozucu, dinamik, log) TEK düğümde, her adımda aynı sırayla çalışır.
      Zaman bir adım sayacıdır (t = k * dt); sonuçlar her çalıştırmada birebir aynıdır.
      Parametre dosyaları multiple_quadrotor.launch ile aynıdır.
    -->
    <arg name="rviz" default="true"/>
    <!-- 1.0: gerçek zaman, 2.0: iki kat hızlı, 0: olabildiğince hızlı (sonuçları değiştirmez) -->
    <arg name="real_time_factor" default="1.0"/>
    <!-- > 0: bu süre (s) sonunda dur, -1: tüm yörüngeler bitince + end_hold_time -->
    <arg name="sim_duration" default="-1.0"/>
    <arg name="end_hold_time" default="2.0"/>
    <arg name="disturbance_enabled" default="true"/>
    <!-- noise_seed >= 0: tekrarlanabilir türbülans, -1: her çalıştırmada rastgele -->
    <arg name="noise_seed" default="42"/>
    <!-- max_vertical_range > 0: bu dikey mesafeden (m) uzak etkileşimler ihmal edilir, -1: sınır yok -->
    <arg name="max_vertical_range" default="-1.0"/>
    <arg name="shutdown_on_finish" default="false"/>
    <!-- Orta seviye kontrolcü: pid (hiyerarşik PID, mevcut hali) veya ndob (PID + doğrusal olmayan bozucu gözlemcisi) -->
    <arg name="controller" default="pid"/>
    <!-- Kontrolcüde bozucu ileri beslemesi: f_des = ... - f_dw (makale Denk. 21). false: kapalı -->
    <arg name="disturbance_feedforward" default="false"/>
    <!-- Yörünge yönlü yaw açısı alçak geçiren filtre katsayısı beta (makale Denk. 19) -->
    <arg name="psi_filter_beta" default="0.05"/>
    <!-- Log klasörü (karşılaştırma koşuları için farklı klasör verilebilir) -->
    <arg name="log_dir" default="$(find multi_quadcopter_control)/log"/>

    <rosparam file="$(find multi_quadcopter_control)/config/trajectory_crescent.yaml" command="load"/>
    <rosparam file="$(find multi_quadcopter_control)/config/all_trajectories.yaml" command="load"/>
    <rosparam file="$(find multi_quadcopter_control)/config/trajectory_hover.yaml" command="load"/>
    <rosparam file="$(find multi_quadcopter_control)/config/trajectory_pid_tuning.yaml" command="load"/>

    <!-- Drone 1 -->
    <group ns="drone1">
        <rosparam file="$(find multi_quadcopter_control)/config/trajectory_manager_drone1.yaml" command="load"/>
        <rosparam file="$(find multi_quadcopter_control)/config/quadcopter_params_1.yaml" command="load"/>
        <param name="initial_x" value="0.0"/>
        <param name="initial_y" value="0.0"/>
        <param name="initial_z" value="0.0"/>
        <param name="robot_description" command="$(find xacro)/xacro $(find multi_quadcopter_control)/urdf/quad_model_v2.urdf" />
    </group>

    <!-- Drone 2 -->
    <group ns="drone2">
        <rosparam file="$(find multi_quadcopter_control)/config/trajectory_manager_drone2.yaml" command="load"/>
        <rosparam file="$(find multi_quadcopter_control)/config/quadcopter_params_2.yaml" command="load"/>
        <param name="initial_x" value="-2.0"/>
        <param name="initial_y" value="2.0"/>
        <param name="initial_z" value="0.0"/>
        <param name="robot_description" command="$(find xacro)/xacro $(find multi_quadcopter_control)/urdf/quad_model_v1.urdf" />
    </group>

    <!-- Drone 3 -->
    <group ns="drone3">
        <rosparam file="$(find multi_quadcopter_control)/config/trajectory_manager_drone3.yaml" command="load"/>
        <rosparam file="$(find multi_quadcopter_control)/config/quadcopter_params_2.yaml" command="load"/>
        <param name="initial_x" value="2.0"/>
        <param name="initial_y" value="2.0"/>
        <param name="initial_z" value="0.0"/>
        <param name="robot_description" command="$(find xacro)/xacro $(find multi_quadcopter_control)/urdf/quad_model_v1.urdf" />
    </group>

    <!-- Drone 4 -->
    <group ns="drone4">
        <rosparam file="$(find multi_quadcopter_control)/config/trajectory_manager_drone4.yaml" command="load"/>
        <rosparam file="$(find multi_quadcopter_control)/config/quadcopter_params_2.yaml" command="load"/>
        <param name="initial_x" value="4.0"/>
        <param name="initial_y" value="4.0"/>
        <param name="initial_z" value="0.0"/>
        <param name="robot_description" command="$(find xacro)/xacro $(find multi_quadcopter_control)/urdf/quad_model_v1.urdf" />
    </group>

    <!-- Drone 5 -->
    <group ns="drone5">
        <rosparam file="$(find multi_quadcopter_control)/config/trajectory_manager_drone5.yaml" command="load"/>
        <rosparam file="$(find multi_quadcopter_control)/config/quadcopter_params_2.yaml" command="load"/>
        <param name="initial_x" value="-4.0"/>
        <param name="initial_y" value="4.0"/>
        <param name="initial_z" value="0.0"/>
        <param name="robot_description" command="$(find xacro)/xacro $(find multi_quadcopter_control)/urdf/quad_model_v1.urdf" />
    </group>

    <param name="num_drones" value="5" />

    <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(find multi_quadcopter_control)/rviz/quad_rviz.rviz" output="screen"/>

    <node name="sequential_sim" pkg="multi_quadcopter_control" type="multi_sequential_sim" output="screen">
        <param name="real_time_factor" value="$(arg real_time_factor)"/>
        <param name="sim_duration" value="$(arg sim_duration)"/>
        <param name="end_hold_time" value="$(arg end_hold_time)"/>
        <param name="shutdown_on_finish" value="$(arg shutdown_on_finish)"/>
        <param name="controller_type" value="$(arg controller)"/>
        <param name="disturbance_feedforward" value="$(arg disturbance_feedforward)"/>
        <param name="psi_filter_beta" value="$(arg psi_filter_beta)"/>
        <!-- RViz / topic yayın frekansları (simülasyon zamanında, Hz) -->
        <param name="viz_rate" value="30.0"/>
        <param name="path_rate" value="10.0"/>
        <param name="publish_topics" value="true"/>
        <!-- Log: log/<drone>_log.txt, data_logger ile aynı sütunlar. 1: her adım (500 Hz) -->
        <param name="log_enabled" value="true"/>
        <param name="log_dir" value="$(arg log_dir)"/>
        <param name="log_decimation" value="1"/>

        <!-- Downwash bozucu modeli: 1/(dz^2 + z0^2), z0 = sqrt(0.05) -> z0^2 = 0.05 -->
        <param name="disturbance_enabled" value="$(arg disturbance_enabled)"/>
        <param name="disturbance_rate" value="500.0"/>
        <param name="noise_seed" value="$(arg noise_seed)"/>
        <param name="max_vertical_range" value="$(arg max_vertical_range)"/>
        <param name="z0" value="0.22360679774997896"/>
        <param name="c_coup" value="0.09"/>
        <param name="r_lat" value="0.05"/>
        <param name="sigma" value="0.15"/>
        <param name="turb_intensity" value="0.70"/>
    </node>
</launch>
